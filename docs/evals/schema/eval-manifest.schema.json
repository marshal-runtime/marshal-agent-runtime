{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.dev/schemas/evals/manifest-1.0.0.json",
  "title": "Marshal evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusVersion",
    "status",
    "frozenAt",
    "baselineStatus",
    "headlineComparison",
    "caseFiles",
    "treatmentsFile",
    "frozenFiles",
    "runPolicy",
    "releaseClaimPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "corpusVersion": { "type": "string", "pattern": "^v[0-9]+$" },
    "status": { "const": "frozen" },
    "frozenAt": { "type": "string", "format": "date" },
    "baselineStatus": { "enum": ["not-captured", "captured"] },
    "headlineComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlTreatmentId", "marshalTreatmentId"],
      "properties": {
        "controlTreatmentId": { "type": "string", "minLength": 1 },
        "marshalTreatmentId": { "type": "string", "minLength": 1 }
      }
    },
    "caseFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^cases/.+\\.json$" }
    },
    "treatmentsFile": { "type": "string", "pattern": "\\.json$" },
    "frozenFiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "runPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumRepetitions", "paired", "randomizedOrder", "publishAllAttempts"],
      "properties": {
        "minimumRepetitions": { "type": "integer", "minimum": 3 },
        "paired": { "const": true },
        "randomizedOrder": { "const": true },
        "publishAllAttempts": { "const": true }
      }
    },
    "releaseClaimPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryMetric", "confidenceInterval", "controlRegressionLimitPercentagePoints"],
      "properties": {
        "primaryMetric": { "const": "weighted-task-success" },
        "confidenceInterval": { "const": 0.95 },
        "controlRegressionLimitPercentagePoints": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
