      "description": "Marshal is enabled without programmable TypeScript execution.",
      "marshal": {
        "installed": true,
        "promptForced": false,
        "capabilities": { "briefing": true, "memory": true, "typescript": false, "ui": true, "subagents": true }
      }
    },
    {
      "id": "marshal-no-ui",
      "kind": "ablation",
