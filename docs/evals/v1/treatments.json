{
  "schemaVersion": "1.0.0",
  "treatments": [
    {
      "id": "codex-baseline",
      "kind": "baseline",
      "headlineEligible": true,
      "description": "Stock Codex with its normal shipped tools and skills; Marshal is absent.",
      "marshal": {
        "installed": false,
        "promptForced": false,
        "capabilities": { "briefing": false, "memory": false, "typescript": false, "ui": false, "subagents": false }
      }
    },
    {
      "id": "codex-marshal",
      "kind": "treatment",
      "headlineEligible": true,
      "description": "The identical Codex build with Marshal installed and automatic capability routing; prompts never name Marshal.",
      "marshal": {
        "installed": true,
        "promptForced": false,
        "capabilities": { "briefing": true, "memory": true, "typescript": true, "ui": true, "subagents": true }
      }
    },
    {
      "id": "marshal-forced",
      "kind": "diagnostic",
      "headlineEligible": false,
      "description": "The prompt explicitly requests Marshal. This measures the capability ceiling, not product discoverability.",
      "marshal": {
        "installed": true,
        "promptForced": true,
        "capabilities": { "briefing": true, "memory": true, "typescript": true, "ui": true, "subagents": true }
      }
    },
    {
      "id": "marshal-no-briefing",
      "kind": "ablation",
