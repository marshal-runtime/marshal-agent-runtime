      "marshal": {
        "installed": true,
        "promptForced": false,
        "capabilities": { "briefing": false, "memory": true, "typescript": true, "ui": true, "subagents": true }
      }
    },
    {
      "id": "marshal-no-memory",
      "kind": "ablation",
      "headlineEligible": false,
      "description": "Marshal is enabled without persistent memory.",
      "marshal": {
        "installed": true,
        "promptForced": false,
