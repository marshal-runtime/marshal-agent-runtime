    {
      "id": "ui-actions-and-modes",
      "catalogExampleIds": ["ui-capability-action", "ui-module-action", "presentation-adaptation"],
      "promptScript": "live-run-script.md#ui-actions-and-modes",
      "prompts": [
        "Turn these project decisions into an interactive review panel I can use here."
      ],
      "requiredCaptureFiles": ["metadata.json", "recorder.json", "host-gates.json", "trace.jsonl", "screen.webm", "prompt.txt", "application.json", "fallback.json", "action-receipts.json", "redaction-manifest.json"],
      "requiredPublicationFiles": ["review.json", "preview.gif", "short.mp4", "derivatives.json"],
      "requiredHostGates": ["inline-pixels", "capability-action", "module-action", "fullscreen", "pip", "text-fallback"],
