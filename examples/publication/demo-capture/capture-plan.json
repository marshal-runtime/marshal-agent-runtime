{
  "version": "1.4.1",
  "rules": {
    "freshSession": true,
    "uncutLiveRequired": true,
    "fixtureOverlaysMustSay": "GENERATED FIXTURE — NOT LIVE EVIDENCE",
    "forbidReconstructedReceipts": true,
    "forbidFabricatedMedia": true,
    "publishEveryAttempt": true,
    "shortMediaMustLinkToUncutHashes": true
  },
  "publicationAutomation": {
    "traceReceiptExport": {
      "tool": "export-trace-receipts.mjs",
      "policy": "canonicalize only exported JSON/JSONL records and extract only receipt-shaped objects already present in the source",
      "doesNotProve": ["host behavior", "receipt truth", "human trace-receipt correspondence"]
    },
    "derivativeGeneration": {
      "tool": "generate-derivatives.mjs",
      "requires": ["capture-level structural acceptance", "operator-authored source ranges", "FFmpeg and FFprobe"],
      "outputs": ["preview.gif", "short.mp4", "derivatives.json"],
      "doesNotAutomate": ["host clicks", "application restart", "fairness review"]
    },
    "allAttemptVerification": {
      "tool": "verify-evidence-set.mjs",
      "ledgerTemplate": "all-attempts.template.json",
      "policy": "reject unlisted bundle directories and reconcile every verified demo attempt with a declared succeeded, failed, interrupted, or unsupported outcome",
      "trustBoundary": "cannot detect a run the operator never preserved under the evidence-set root"
    }
  },
  "demos": [
    {
      "id": "automatic-memory",
      "catalogExampleIds": ["automatic-memory-lifecycle"],
      "promptScript": "live-run-script.md#automatic-memory",
      "prompts": [
        "Remember that my publication accent color is ultramarine.",
        "What publication accent color did I choose earlier?"
      ],
      "requiredCaptureFiles": ["metadata.json", "recorder.json", "trace.jsonl", "screen.webm", "prompt.txt", "write-receipt.json", "recall-receipt.json", "redaction-manifest.json"],
      "requiredPublicationFiles": ["review.json", "preview.gif", "short.mp4", "derivatives.json"],
      "mustShow": ["fresh first task", "pre-response semantic Brain remember receipt", "fresh second task", "naturally selected semantic Brain recall receipt", "scope identity", "hook enqueue remains non-blocking"]
    },
    {
      "id": "ordinary-typescript",
      "catalogExampleIds": ["ordinary-typescript"],
      "promptScript": "live-run-script.md#ordinary-typescript",
      "prompts": [
        "Summarize the attached order fixture by region, make the calculation reusable, and show the exact result."
      ],
      "requiredCaptureFiles": ["metadata.json", "recorder.json", "trace.jsonl", "screen.webm", "prompt.txt", "module-source.ts", "execution-receipt.json", "redaction-manifest.json"],
      "requiredPublicationFiles": ["review.json", "preview.gif", "short.mp4", "derivatives.json"],
      "mustShow": ["prompt does not name Marshal", "editable source", "source digest", "non-UI result"]
    },
    {
      "id": "capability-composition",
      "catalogExampleIds": ["capability-composition"],
      "promptScript": "live-run-script.md#capability-composition",
      "prompts": [
        "Create a reusable project brief from the attached project notes. Include any relevant preference you already know, preserve the result, and report where it was saved."
      ],
      "requiredCaptureFiles": ["metadata.json", "recorder.json", "trace.jsonl", "screen.webm", "prompt.txt", "module-source.ts", "result.json", "nested-receipts.jsonl", "redaction-manifest.json"],
      "requiredPublicationFiles": ["review.json", "preview.gif", "short.mp4", "derivatives.json"],
      "mustShow": ["indirect prompt", "editable composition module", "attachment or project input", "memory lookup", "durable artifact", "parent-child receipts"]
    },
    {
      "id": "bounded-delegation",
      "catalogExampleIds": ["bounded-delegation"],
      "promptScript": "live-run-script.md#bounded-delegation",
      "prompts": [
        "Review this release candidate from architecture, security, and operator perspectives in parallel, then synthesize one recommendation and preserve the review."
      ],
      "requiredCaptureFiles": ["metadata.json", "recorder.json", "trace.jsonl", "screen.webm", "prompt.txt", "orchestration-source.ts", "result.json", "redaction-manifest.json"],
      "requiredPublicationFiles": ["review.json", "preview.gif", "short.mp4", "derivatives.json"],
      "mustShow": ["indirect prompt", "parallel host sessions", "returned delegation IDs", "plain terminal results", "synthesized review"]
