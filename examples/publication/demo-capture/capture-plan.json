      "requiredCaptureFiles": ["metadata.json", "recorder.json", "host-gates.json", "trace.jsonl", "screen.webm", "prompt.txt", "permissions.json", "receipts.jsonl", "source-manifest.json", "redaction-manifest.json"],
      "requiredPublicationFiles": ["review.json", "preview.gif", "short.mp4", "derivatives.json"],
      "requiredHostGates": ["inline-pixels", "backend-action", "targeted-edit", "fullscreen", "pip", "product-restart", "historical-reopen", "restored-state"],
      "mustShow": ["fresh implicit prompt", "autonomous routing", "bounded useful fan-out", "synthesis", "live app", "declared backend action", "targeted edit", "restart restoration"]
    }
  ]
}
