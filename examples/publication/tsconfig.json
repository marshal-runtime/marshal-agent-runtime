{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@marshal/agent-runtime-core": ["packages/agent-runtime-core/src/index.ts"],
      "@marshal/agent-runtime-host": ["packages/agent-runtime-host/src/index.ts"],
      "@marshal/agent-runtime-typescript": ["packages/agent-runtime-typescript/src/index.ts"],
      "@marshal/agent-runtime-ui": ["packages/agent-runtime-ui/src/index.ts"],
      "@marshal/runtime": ["packages/runtime/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["__tests__"]
}
