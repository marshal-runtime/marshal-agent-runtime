{
  "name": "@marshal/agent-runtime-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Portable programmable capability runtime for agent harnesses",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "bootstrap": "node scripts/fetch-quillstone.mjs && pnpm install --frozen-lockfile",
    "quillstone:fetch": "node scripts/fetch-quillstone.mjs",
    "quillstone:pin": "node scripts/set-quillstone.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "repository": "node scripts/check-repository.mjs",
    "manifests": "node scripts/check-manifests.mjs",
    "build": "node scripts/run-workspace-script.mjs build",
    "typecheck": "node scripts/run-workspace-script.mjs typecheck",
    "test": "node scripts/run-workspace-script.mjs test",
    "pack:check": "node scripts/check-packs.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:platform": "node scripts/platform-acceptance.mjs",
    "evals:validate": "node scripts/validate-evals.mjs",
    "evals:prepare-offline-smoke": "node scripts/evals/prepare-offline-smoke.mjs",
    "evals:run": "node scripts/evals/run.mjs",
    "evals:report": "node scripts/evals/report.mjs",
    "evals:test": "node --test scripts/evals/__tests__/*.test.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "benchmark:codex-hooks": "node scripts/benchmarks/codex-hook-baseline.mjs",
    "probe:warm-luna": "node scripts/probes/warm-luna-appserver.mjs",
    "smoke:installed-codex": "node scripts/smoke-installed-codex.mjs",
    "smoke:installed-adaptive-agentic": "node scripts/run-workspace-script.mjs build && node scripts/smoke-installed-adaptive-agentic.mjs",
    "smoke:detached-mcp": "node scripts/run-workspace-script.mjs build && node scripts/smoke-detached-mcp.mjs",
    "smoke:native-delegation": "node scripts/smoke-native-delegation.mjs",
    "conformance:g13": "node scripts/g13-conformance.mjs",
    "demo:g14": "node scripts/g14-runtime-demo.mjs",
    "publication:offline": "node scripts/publication-offline.mjs",
    "release:inventory": "node scripts/release-inventory.mjs",
    "release:inventory:check": "node scripts/release-inventory.mjs --check",
    "release:policy": "node scripts/release-policy.mjs --template",
    "release:plan": "node scripts/release-publish-matrix.mjs --plan",
    "release:test": "node --test examples/publication/__tests__/release-engineering.test.mjs examples/publication/__tests__/packed-manifest.test.mjs",
    "release:check": "node scripts/release-policy.mjs --template && node scripts/release-inventory.mjs --check && node scripts/release-publish-matrix.mjs --plan --json",
    "release:authorize": "node scripts/release-policy.mjs --authority .github/release-authority.json",
    "release:publish-dry-run": "node scripts/release-publish-matrix.mjs --dry-run --authority .github/release-authority.json",
    "verify:structure": "node scripts/check-repository.mjs && node scripts/check-boundaries.mjs && node scripts/check-manifests.mjs && node scripts/validate-docs.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@marshal/runtime": "workspace:*",
    "@openai/codex": "^0.144.5"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
