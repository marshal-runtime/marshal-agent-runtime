{
  "name": "@marshal/agent-runtime-codex-capabilities",
  "version": "0.1.0",
  "description": "Portable Codex subagent and declarative custom-UI capability providers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@marshal/agent-runtime-core": "workspace:*",
    "@marshal/agent-runtime-delegation": "workspace:*",
    "@marshal/agent-runtime-effects": "workspace:*",
    "@marshal/agent-runtime-ui": "workspace:*",
    "@openai/apps-sdk-ui": "0.2.2",
    "@openai/codex": "^0.144.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@marshal/agent-runtime-conformance": "workspace:*",
    "@types/node": "^20.10.0",
    "@types/react": "18.3.31",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
