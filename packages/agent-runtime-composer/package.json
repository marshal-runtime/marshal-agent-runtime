{
  "name": "@marshal/agent-runtime-composer",
  "version": "0.1.0",
  "description": "Harness-neutral binding composer for the Marshal agent runtime kernel",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@marshal/agent-runtime-core": "workspace:*",
    "typescript": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
