{
  "name": "@marshal/agent-runtime-conformance",
  "version": "0.1.0",
  "description": "Harness-neutral conformance assertions for Marshal runtime adapters",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@marshal/agent-runtime-composer": "workspace:*",
    "@marshal/agent-runtime-core": "workspace:*",
    "@marshal/agent-runtime-ui": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^25.2.3",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4",
    "zod": "4.4.3"
  },
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
