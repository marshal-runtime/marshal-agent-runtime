{
  "name": "@marshal/agent-runtime-delegation",
  "version": "0.1.0",
  "description": "Portable transport for spawning, waiting for, and cancelling delegated agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@marshal/agent-runtime-composer": "workspace:*",
    "@marshal/agent-runtime-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.13.0" },
  "license": "MIT"
}
