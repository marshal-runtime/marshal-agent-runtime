{
  "name": "@marshal/agent-runtime-dsh",
  "version": "0.1.0",
  "description": "Portable DSH/Cordis compatibility adapter for Marshal Runtime extensions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.spec.*",
    "!src/**/*.spec.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@marshal/agent-runtime-core": "workspace:*",
    "@marshal/agent-runtime-composer": "workspace:*",
    "@marshal/agent-runtime-extensions": "workspace:*",
    "@marshal/agent-runtime-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "engines": { "node": ">=22.13.0" }
}
