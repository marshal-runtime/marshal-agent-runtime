{
  "name": "@marshal/agent-runtime-typescript",
  "version": "0.1.0",
  "description": "Portable direct TypeScript execution and TypeScript-authored extension materialization for capability-brokered agent runtimes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marshal/agent-runtime-composer": "workspace:*",
    "@marshal/agent-runtime-core": "workspace:*",
    "@marshal/agent-runtime-extensions": "workspace:*",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.2"
  },
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
