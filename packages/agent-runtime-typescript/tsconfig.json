{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@marshal/agent-runtime-composer": ["../agent-runtime-composer/dist/index.d.ts"],
      "@marshal/agent-runtime-core": ["../agent-runtime-core/dist/index.d.ts"],
      "@marshal/agent-runtime-extensions": ["../agent-runtime-extensions/dist/index.d.ts"]
    },
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "__tests__"]
}
