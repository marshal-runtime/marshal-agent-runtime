{
  "name": "@marshal/agent-runtime-ui",
  "version": "0.1.0",
  "description": "Portable, permissioned React UI compilation and MCP Apps resources for agent runtimes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./declarative": {
      "types": "./dist/declarative/index.d.ts",
      "default": "./dist/declarative/index.js"
    },
    "./declarative/browser": {
      "types": "./dist/declarative/browser.d.ts",
      "default": "./dist/declarative/browser.js"
    },
    "./authored-state": {
      "types": "./dist/authored-state/index.d.ts",
      "default": "./dist/authored-state/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/__tests__",
    "!src/__tests__",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@marshal/agent-runtime-core": "workspace:*",
    "@marshal/agent-runtime-composer": "workspace:*",
    "esbuild": "^0.27.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
